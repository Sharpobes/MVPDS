@model List<MVPDS.Entities.VoiceServer>
@{
    ViewData["Title"] = "Список серверов";
    Layout = "_Layout";
}

<h2>Серверы</h2>

<form method="post" asp-action="HandleServerAction" asp-controller="Voice" class="mb-3">
    <input type="text" name="serverName" placeholder="Название сервера" required class="form-control d-inline w-auto" />
    
    <button type="submit" name="actionType" value="join" class="btn btn-primary ml-1">Подключиться</button>
    <button type="submit" name="actionType" value="create" class="btn btn-success ml-1">Создать сервер</button>
</form>

@if (Model == null || !Model.Any())
{
    <p class="text-muted mt-3">На данный момент вы не являетесь участником ни одного из серверов.</p>
}
else
{
    <ul>
        @foreach (var server in Model)
        {
            <li>
                <strong>@server.ServerName</strong>
                <a asp-controller="Voice" asp-action="Channels" asp-route-id="@server.VoiceServersId" class="btn btn-sm btn-outline-primary ml-2">Открыть</a>

                <form asp-action="DeleteServer" asp-controller="Voice" method="post" class="d-inline ml-2" onsubmit="return confirm('Удалить сервер?');">
                    <input type="hidden" name="serverId" value="@server.VoiceServersId" />
                    <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                </form>
            </li>
        }
    </ul>
}