@model List<MVPDS.Entities.VoiceServer>
@{
    ViewData["Title"] = "Список серверов";
    Layout = "_Layout";
}

<h2>Серверы</h2>

<form method="post" asp-action="JoinServer" asp-controller="Voice" class="mb-4">
    <input type="text" name="serverName" placeholder="Введите название сервера" required class="form-control d-inline w-auto" />
    <button type="submit" class="btn btn-primary">Подключиться</button>
</form>

@if (!Model.Any())
{
    <p class="text-muted mt-3">На данный момент вы не являетесь участником ни одного из серверов.</p>
}
else
{
    <ul>
        @foreach (var server in Model)
        {
            <li>
                <strong>@server.ServerName</strong>
                <a asp-controller="Voice" asp-action="Channels" asp-route-id="@server.VoiceServersId" class="btn btn-sm btn-outline-primary ml-2">Открыть</a>
            </li>
        }
    </ul>
}